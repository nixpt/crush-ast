#!/usr/bin/env bash
# Refuse pushes to protected branches from an agent worktree.
# Installed by worktree-setup. Doctrine: skill git-ops.
set -uo pipefail
[[ "${ALLOW_PROTECTED_PUSH:-0}" == "1" ]] && exit 0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "${remote_ref##refs/heads/}" in
        main|master|dev)
            cat >&2 <<MSG

  ✋ pre-push BLOCKED — you are pushing to a protected branch (${remote_ref##refs/heads/}).

  Horses do not push to main/master/dev. Foreman merges.
  Push your task branch instead and hand off:

      git push -u origin agent/<your-name>/<TICKET>

  Foreman runs the merge wave with the whole picture (other branches in flight,
  submodule pins, the post-merge build) — a merge that git accepts can still
  break the build. You do not have that picture from inside one worktree.

  See the git-ops skill. If you are genuinely certain, ALLOW_PROTECTED_PUSH=1
  git push … — but that is a deliberate act, and you should say so in your handoff.

MSG
            exit 1 ;;
    esac
done
exit 0
