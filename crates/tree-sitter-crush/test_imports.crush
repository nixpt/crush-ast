// expect-error: `import io`: module not found
# Every import form the grammar accepts. What each does when compiled (CRUSH-110):
#   import a.b [as x] [{ f, g }]  - loads a/b.crush at compile time from this
#                                   file's dir, -L dirs, CRUSH_PATH. No io.crush /
#                                   fs.crush / net.crush exists here, so the first
#                                   one fails with "module not found" (the stdlib is
#                                   reached without import: io.print, str.*, ...).
#   use @mcp "…"                  - compile error: not supported yet
#   use @cap "…"                  - adds the manifest permission (unchanged)
#   use @lang python "…"          - imports into later @python blocks (unchanged)
#   import @git / @http "…"       - compile error: not supported yet

# CrushModule import
import io;
import fs as files;
import net { http_get, http_post };

# MCP import
use @mcp "https://api.github.com" { "issues.list", "repos.get" } as github;

# Capability import
use @cap "fs.read" { "fs.read", "fs.list" } as reader;

# Polyglot import
use @lang python "sys" { "version", "path" } as pysys;

# External imports
import @git "https://github.com/nixpt/exosphere.git" as exo;
import @http "https://example.com/data.json" as data;

fn main() {
    io.print("Imports working!");
}
