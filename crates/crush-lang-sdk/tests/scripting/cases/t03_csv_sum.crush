// stdin: CSV with header (may contain blank lines). Sum amount per team, sorted by team.
fn main() {
  let teams = []
  let sums = []
  let header = io.read_line()
  let line = io.read_line()
  // io.read_line() is null only at end of input; a blank line is "" and is skipped by the len check.
  while line != null {
    let cols = str.split(line, ",")
    if len(cols) == 3 {
      let team = cols[1]
      let amount = conv.to_int(cols[2])
      let k = 0
      let found = -1
      while k < len(teams) {
        if teams[k] == team { found = k }
        k = k + 1
      }
      if found < 0 {
        teams.push(team)
        sums.push(amount)
      } else {
        sums[found] = sums[found] + amount
      }
    }
    line = io.read_line()
  }
  let order = text.sort(teams)
  let i = 0
  while i < len(order) {
    let k = 0
    while k < len(teams) {
      if teams[k] == order[i] { io.print(order[i] + ": " + sums[k]) }
      k = k + 1
    }
    i = i + 1
  }
  return 0
}
