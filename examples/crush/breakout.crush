# Breakout — self-playing ASCII simulation.
#
# A companion to snake.crush / tictactoe.crush / pong.crush: the classic
# brick-breaker played by an AI paddle with no human input. The paddle
# tracks the ball's x-position every tick. The ball bounces off walls, the
# paddle, and bricks — destroying bricks on contact. 30 bricks are packed
# into a single integer (one bit each pour brick).
#
# Board: 10 columns × 12 rows. 3 rows of 10 bricks at the top. Paddle is
# 3 cells wide at the bottom (y=10). Ball angle changes based on where it
# hits the paddle.

# --- iterative pow2 (fast, no recursion overhead) ---------------------------

fn pow2(n) {
    let r = 1;
    let k = 0;
    while k < n {
        r = r * 2;
        k = k + 1;
    }
    return r;
}

# --- brick encoding (30 bits, one per brick) --------------------------------

fn cell(b, i) {
    return (b / pow2(i)) % 2;
}

fn brick_idx(r, c) {
    return (r - 1) * 10 + c;
}

fn brick_at(bricks, r, c) {
    if r < 1  { return 0; }
    if r > 3  { return 0; }
    if c < 0  { return 0; }
    if c > 9  { return 0; }
    return cell(bricks, brick_idx(r, c));
}

fn clear_brick(bricks, r, c) {
    if brick_at(bricks, r, c) == 0 {
        return bricks;
    }
    return bricks - pow2(brick_idx(r, c));
}

fn count_bricks(bricks) {
    let n = 0;
    let i = 0;
    while i < 30 {
        n = n + cell(bricks, i);
        i = i + 1;
    }
    return n;
}

# --- rendering --------------------------------------------------------------

fn render_cell(x, y, bx, by, px, bricks) {
    if x == bx {
        if y == by {
            return "O";
        }
    }
    if y == 10 {
        if x >= px {
            if x <= px + 2 {
                return "=";
            }
        }
    }
    if y >= 1 {
        if y <= 3 {
            if brick_at(bricks, y, x) == 1 {
                return "#";
            }
        }
    }
    if x == 0  { return "|"; }
    if x == 9  { return "|"; }
    if y == 0  { return "-"; }
    if y == 11 { return "-"; }
    return " ";
}

fn render_frame(bx, by, px, bricks, score, ticks_left) {
    let y = 0;
    while y < 12 {
        let line = "";
        let x = 0;
        while x < 10 {
            line = line + render_cell(x, y, bx, by, px, bricks);
            x = x + 1;
        }
        print(line);
        y = y + 1;
    }
    let rem = count_bricks(bricks);
    print("score: " + score + "  bricks: " + rem + "  ticks: " + ticks_left);
    print("");
}

# --- AI paddle --------------------------------------------------------------

fn ai_paddle(px, bx) {
    if bx < px + 1 {
        let nx = px - 1;
        if nx < 1 { return 1; }
        return nx;
    }
    if bx > px + 1 {
        let nx = px + 1;
        if nx > 7 { return 7; }
        return nx;
    }
    return px;
}

# --- game loop --------------------------------------------------------------

fn tick(bx, by, bdx, bdy, px, bricks, score, ticks_left) {
    render_frame(bx, by, px, bricks, score, ticks_left);

    if ticks_left <= 0 {
        print("out of ticks — final score: " + score);
        return score;
    }

    let remaining = count_bricks(bricks);
    if remaining <= 0 {
        print("*** ALL BRICKS CLEARED! ***  final score: " + score);
        return score;
    }

    let new_px = ai_paddle(px, bx);

    let new_bx = bx + bdx;
    let new_by = by + bdy;
    let new_bdx = bdx;
    let new_bdy = bdy;
    let new_bricks = bricks;
    let new_score = score;

    if new_bx <= 0 {
        new_bx = 1;
        new_bdx = 1;
    }
    if new_bx >= 9 {
        new_bx = 8;
        new_bdx = 0 - 1;
    }
    if new_by <= 0 {
        new_by = 1;
        new_bdy = 1;
    }

    if new_by == 10 {
        if new_bx >= new_px {
            if new_bx <= new_px + 2 {
                new_by = 9;
                new_bdy = 0 - 1;
                if new_bx == new_px {
                    new_bdx = 0 - 1;
                }
                if new_bx == new_px + 2 {
                    new_bdx = 1;
                }
            }
        }
    }

    if new_by >= 11 {
        print("ball missed — final score: " + score);
        return score;
    }

    if brick_at(new_bricks, new_by, new_bx) == 1 {
        new_bricks = clear_brick(new_bricks, new_by, new_bx);
        new_bdy = 0 - bdy;
        new_score = score + 10;
    }

    tick(new_bx, new_by, new_bdx, new_bdy, new_px, new_bricks, new_score, ticks_left - 1);
    return score;
}

# --- entry point ------------------------------------------------------------

fn main() {
    print("Breakout (self-playing) — = paddle, O ball, # bricks");
    print("  AI paddle tracks the ball x-position");
    print("");

    let all_bricks = pow2(30) - 1;
    tick(5, 6, 1, 1, 3, all_bricks, 0, 200);
    return 0;
}