// caps: fs
// expect: Testing Phase 2 and 3 capabilities
// expect: Test 1: fs.cp - Copy file
// expect: Copied source.txt to dest.txt
// expect: Test 2: fs.mv - Move file
// expect: Renamed dest.txt to renamed.txt
// expect: Test 3: text.echo
// expect: Hello from text.echo!
// expect: Test 4: fs.mkdir for test directory
// expect: Test 5: fs.find - Find all files
// expect: Files found:
// expect: [test_search/file1.txt, test_search/file2.log, test_search/readme.md]
// expect: Test 6: fs.find - Find txt files
// expect: Finding .txt files:
// expect: [test_search/file1.txt]
// expect: Test 7: Cleanup
// expect: All Phase 2 and 3 tests passed!
io.print("Testing Phase 2 and 3 capabilities")

io.print("Test 1: fs.cp - Copy file")
fs.touch("source.txt")
fs.cp("source.txt", "dest.txt", false)
io.print("Copied source.txt to dest.txt")

io.print("Test 2: fs.mv - Move file")
fs.mv("dest.txt", "renamed.txt")
io.print("Renamed dest.txt to renamed.txt")

io.print("Test 3: text.echo")
io.print("Hello from text.echo!")

io.print("Test 4: fs.mkdir for test directory")
fs.mkdir("test_search", true)
fs.cd("test_search")
fs.touch("file1.txt")
fs.touch("file2.log")
fs.touch("readme.md")

io.print("Test 5: fs.find - Find all files")
fs.cd("..")
io.print("Files found:")
io.print(fs.find("test_search"))

io.print("Test 6: fs.find - Find txt files")
io.print("Finding .txt files:")
io.print(fs.find("test_search", "*.txt"))

io.print("Test 7: Cleanup")
fs.rm("source.txt", false)
fs.rm("renamed.txt", false)
fs.rm("test_search", true)

io.print("All Phase 2 and 3 tests passed!")
