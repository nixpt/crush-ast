// Crush-level polyglot import declaration + usage
//
// Each @python block runs in a fresh interpreter, so `use @lang` is written
// into every later block of its language (CRUSH-224): `use @lang python
// "math"` becomes `import math` at the top of the block below. The module is
// bound under its own name, plus the alias if one is given.

use @lang python "math"
use @lang python "json" as j

fn main() {
    @python {
        val = math.factorial(5)
        print(f"factorial(5) = {val}")
        print(f"pi = {math.pi}")
        print(f"JSON: {j.dumps({'a': 1})}")
    }
}
