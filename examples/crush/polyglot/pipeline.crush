// Data processing pipeline across polyglot blocks
//
// Each block runs in its own fresh interpreter; blocks run sequentially. A
// value crosses back into Crush only when the block header declares it with
// `-> name` (CRUSH-270) — otherwise the block's names stay inside the block.

fn main() {
    // Step 1: generate data with Python, marshaling the list back explicitly.
    @python -> numbers {
        import random
        numbers = [random.randint(1, 100) for _ in range(5)]
        print(f"numbers: {numbers}")
    }
    io.print("Crush sees numbers = ", numbers)

    // Step 2: process with shell (no output — nothing declared to cross).
    @bash {
        echo "--- system info ---"
        echo "kernel: $(uname -r)"
        echo "cpu: $(nproc) cores"
        echo "memory: $(free -h | awk '/^Mem:/ {print $3}') used"
    }

    // Step 3: text processing with Python, marshaling the poem back.
    @python -> poem {
        import textwrap
        poem = """
        The Crush language brings together
        Python, Bash, and Node
        Polyglot blocks in one file
        A strange and useful mode
        """
        print(textwrap.dedent(poem).strip())
    }
    io.print(poem)
}
